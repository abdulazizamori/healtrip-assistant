# Copy to .env next to docker-compose.yml
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite

# Optional backup provider, used only while every Gemini model is unavailable (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
