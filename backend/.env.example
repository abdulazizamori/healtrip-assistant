# Copy to .env and fill in. Never commit .env.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# used only while the primary model is out of quota or overloaded (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite

# Optional backup provider, used only while every Gemini model is out of quota or down.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# The API uses the READ-ONLY database role
DATABASE_URL=postgresql://healtrip_agent_ro:readonly_dev_password@localhost:5432/healtrip

ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=20
MAX_CLARIFYING_QUESTIONS=4
